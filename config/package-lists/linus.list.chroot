# linus live image — chroot package list
# Packages here are installed into the squashfs (the live system).
#
# Phase 1: sway + greetd autologin + mantle runtime deps.
# Phase 2: add linus-desktop (meta) which pulls linus-session and linus-greeter
#          from the linus apt repo, plus calamares for the graphical installer.
#
# See contracts/system-packages.md for the authoritative pinned package set.

# --- Wayland compositor ---
sway
swayidle
swaylock
swaybg

# --- Terminal (live fallback when mantle is absent) ---
foot

# --- Greeter / session manager ---
# greetd: Phase 1 autologin + Phase 2 gtkgreet graphical greeter
# cage: Wayland kiosk compositor for gtkgreet (Phase 2)
greetd
cage
gtkgreet

# --- Audio ---
pipewire
pipewire-audio
pipewire-pulse
wireplumber
libspa-0.2-bluetooth
pavucontrol

# --- Network ---
network-manager
network-manager-gnome

# --- Power management ---
upower

# --- XDG portals (required by mantle / Tauri 2) ---
xdg-desktop-portal
xdg-desktop-portal-wlr
xdg-desktop-portal-gtk

# --- Session plumbing ---
# NB: the daemon is `polkitd` on trixie (it was renamed from `polkit` in bookworm),
# and `policykit-1-gnome` no longer exists — mate-polkit is the GTK authentication
# agent that pairs with wlroots compositors like sway.
dbus-user-session
polkitd
mate-polkit
xdg-utils

# --- Fonts ---
fonts-noto-core
fonts-noto-color-emoji
fonts-noto-mono

# --- Browser and file manager ---
firefox-esr
thunar
gvfs
gvfs-backends

# --- mantle runtime dependencies ---
# mantle itself comes from the linus apt repo; these are its Tauri 2 runtime Depends.
libwebkit2gtk-4.1-0
libayatana-appindicator3-1

# --- Wayland utilities ---
brightnessctl
wl-clipboard
grim
slurp

# --- Boot splash ---
# linus-branding provides the linus Plymouth theme over these base packages.
plymouth
plymouth-themes

# --- Live system utilities ---
curl
wget
git
