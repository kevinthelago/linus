# linus live image — chroot package list
# Packages here are installed into the squashfs (the live system).
#
# Phase 1: sway + greetd autologin + mantle runtime deps.
# Phase 2: add linus-desktop (meta) which pulls linus-session and linus-greeter
#          from the linus apt repo, plus calamares for the graphical installer.
#
# See contracts/system-packages.md for the authoritative pinned package set.

# --- Wayland compositor ---
sway
swayidle
swaylock
swaybg

# --- Terminal (live fallback when mantle is absent) ---
foot

# --- Greeter / session manager ---
# greetd: Phase 1 autologin + Phase 2 gtkgreet graphical greeter
# cage: Wayland kiosk compositor for gtkgreet (Phase 2)
greetd
cage
gtkgreet

# --- Audio ---
pipewire
pipewire-pulse
wireplumber
pavucontrol

# --- Network ---
network-manager
network-manager-gnome

# --- XDG portals (required by mantle / Tauri 2) ---
xdg-desktop-portal
xdg-desktop-portal-wlr
xdg-desktop-portal-gtk

# --- Session plumbing ---
dbus-user-session
polkit
policykit-1-gnome

# --- Fonts ---
fonts-noto-core
fonts-noto-color-emoji

# --- Browser and file manager ---
firefox-esr
thunar

# --- mantle runtime dependencies ---
# mantle itself comes from the linus apt repo; these are its Tauri 2 runtime Depends.
libwebkit2gtk-4.1-0
libayatana-appindicator3-1

# --- Wayland utilities ---
brightnessctl
wl-clipboard
grim
slurp

# --- Live system utilities ---
curl
wget
git

# --- linus packages (from linus apt repo via LINUS_REPO_URL) ---
# Uncommented automatically when the apt repo is configured.
# linus-session
# linus-greeter
# linus-desktop
