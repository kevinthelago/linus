#!/bin/sh
# 0200-session.hook.chroot
# Enable system services required for the linus desktop session.
set -eu

# greetd is the session manager for both live (autologin) and installed (gtkgreet).
systemctl enable greetd.service 2>/dev/null || true

# NetworkManager for live network access.
systemctl enable NetworkManager.service 2>/dev/null || true

# polkit for privilege escalation (network, mounts, power).
systemctl enable polkit.service 2>/dev/null || true
