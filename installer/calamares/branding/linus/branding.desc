---
# Calamares branding descriptor for linus.
# Image assets (productLogo, productIcon, productWelcome) are provided at runtime
# by the linus-branding package, installed to /etc/calamares/branding/linus/.

componentName: linus

strings:
    productName:          "linus"
    shortProductName:     "linus"
    version:              "1.0"
    shortVersion:         "1.0"
    versionedName:        "linus 1.0"
    shortVersionedName:   "linus 1.0"
    bootloaderEntryName:  "linus"
    productUrl:           "https://github.com/kevinthelago/linus"
    supportUrl:           "https://github.com/kevinthelago/linus/issues"
    knownIssuesUrl:       "https://github.com/kevinthelago/linus/issues"
    releaseNotesUrl:      "https://github.com/kevinthelago/linus/releases"

images:
    # SVGs copied from branding/icons/ by mk/installer.mk at build time.
    productLogo:          "linus-logo.svg"
    productIcon:          "linus-icon.svg"
    # Wallpaper installed by linus-branding (a Depends of this package).
    productWelcome:       "/usr/share/backgrounds/linus/default.svg"

slideshow:      "show.qml"
slideshowAPI:   2

style:
    # Catppuccin Mocha — matches branding/mantle/theme/tokens.css
    sidebarBackground:          "#1e1e2e"
    sidebarText:                "#cdd6f4"
    sidebarTextSelect:          "#cba6f7"
    sidebarTextHighlight:       "#cba6f7"
    sidebarBackgroundSelected:  "#313244"
