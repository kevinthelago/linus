#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	# nothing to compile — assets only

override_dh_auto_install:
	# os-release
	install -Dm644 branding/os-release \
		debian/linus-branding/etc/os-release
	install -Dm644 branding/os-release \
		debian/linus-branding/usr/lib/os-release

	# Plymouth theme
	install -d debian/linus-branding/usr/share/plymouth/themes/linus
	install -Dm644 branding/plymouth/linus/linus.plymouth \
		debian/linus-branding/usr/share/plymouth/themes/linus/linus.plymouth
	install -Dm644 branding/plymouth/linus/linus.script \
		debian/linus-branding/usr/share/plymouth/themes/linus/linus.script

	# Wallpaper
	install -Dm644 branding/wallpaper/linus-default.svg \
		debian/linus-branding/usr/share/backgrounds/linus/linus-default.svg

	# Icons / logo
	install -Dm644 branding/icons/linus-logo.svg \
		debian/linus-branding/usr/share/icons/hicolor/scalable/apps/linus-logo.svg
	install -Dm644 branding/icons/linus-logo-16.svg \
		debian/linus-branding/usr/share/icons/hicolor/16x16/apps/linus-logo.svg
	install -Dm644 branding/icons/linus-logo-32.svg \
		debian/linus-branding/usr/share/icons/hicolor/32x32/apps/linus-logo.svg

	# gtkgreet stylesheet
	install -Dm644 branding/gtkgreet/style.css \
		debian/linus-branding/usr/share/linus/gtkgreet/style.css

	# Mantle default theme + config
	install -Dm644 branding/mantle/theme.css \
		debian/linus-branding/etc/mantle/theme.css
	install -Dm644 branding/mantle/theme.css \
		debian/linus-branding/etc/skel/.config/mantle/theme.css
	install -Dm644 branding/mantle/config.toml \
		debian/linus-branding/etc/mantle/config.toml
	install -Dm644 branding/mantle/config.toml \
		debian/linus-branding/etc/skel/.config/mantle/config.toml

	# GRUB branding fragment
	install -Dm644 branding/grub/linus-grub.cfg \
		debian/linus-branding/usr/share/linus/grub/linus-grub.cfg
	install -Dm644 branding/grub/theme/theme.txt \
		debian/linus-branding/usr/share/grub/themes/linus/theme.txt

override_dh_installchangelogs:
	dh_installchangelogs

override_dh_compress:
	dh_compress -X.svg -X.css -X.toml -X.cfg
