#!/bin/sh
set -e

# Ensure public session commands are executable (dpkg-deb preserves mode,
# but belt-and-suspenders on upgrades from older package versions)
chmod +x /usr/bin/linus-session
chmod +x /usr/bin/linus-hyprland-session
chmod +x /usr/lib/linus/mantle-watchdog.sh
chmod +x /usr/lib/linus/mantle-watchdog-hypr.sh

#DEBHELPER#
